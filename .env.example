
# ==========================================
# APPLICATION SETTINGS
# ==========================================
APP_NAME=ExamGuard AI
APP_ENV=development
DEBUG=True

# ==========================================
# DATABASE CONNECTION
# ==========================================
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/examguard_db

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Exam access tokens are short-lived and rotated through one-time refresh tokens.
EXAM_ACCESS_TOKEN_EXPIRE_MINUTES=10

# ==========================================
# SECURITY SETTINGS
# ==========================================
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5

# ==========================================
# FRONTEND AND CORS
# ==========================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ==========================================
# FILE UPLOAD SETTINGS
# ==========================================
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
THUMBNAIL_MAX_SIZE=400

# ==========================================
# EXAM SCHEDULES
# Exam opening/closing values are entered in Asia/Kolkata (IST, UTC+05:30).
# Stored timestamps are normalized to UTC by the backend.

# ==========================================
# EXAM SESSION SETTINGS
# ==========================================
EXAM_SESSION_HEARTBEAT_SECONDS=10
EXAM_AUTO_SUBMIT_CHECK_SECONDS=15

# ==========================================
# AI GRADING SETTINGS
# ==========================================
# Backend only. Never place these values in frontend/.env or source code.
# All AI evaluation requests authenticate only with MENTORS_API_KEY.
# Set MENTORS_API_BASE_URL when the mentor's provider uses a custom endpoint.
MENTORS_API_KEY=
MENTORS_API_BASE_URL=
MENTORS_API_MODEL=gpt-4o-mini
AI_GRADING_ENABLED=False

# ==========================================
# OCR SETTINGS
# ==========================================
TESSERACT_CMD=

# ==========================================
# PROCTORING SETTINGS
# ==========================================
PROCTORING_ENABLED=True
MAX_TAB_SWITCH_WARNINGS=3
